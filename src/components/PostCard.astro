---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  href: string;
}

const { title, description, pubDate, href } = Astro.props;
const dateLabel = pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});
---

<article class="post-card">
  <time class="post-card-date" datetime={pubDate.toISOString()}>{dateLabel}</time>
  <div class="post-card-copy">
    <h3 class="post-card-title"><a href={href}>{title}</a></h3>
    <p class="post-card-desc">{description}</p>
  </div>
</article>
