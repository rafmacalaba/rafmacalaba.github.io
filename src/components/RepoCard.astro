---
import LangChip from "./LangChip.astro";

interface Props {
  name: string;
  description: string | null;
  html_url: string;
  language: string | null;
  stargazers_count: number;
  forks_count: number;
}
const { name, description, html_url, language, stargazers_count, forks_count } =
  Astro.props;
---

<article class="repo-card" data-language={language ?? "Unknown"}>
  <header class="repo-card-header">
    <h3 class="repo-card-title">
      <a href={html_url} rel="noopener noreferrer">{name}</a>
    </h3>
    <LangChip language={language} />
  </header>
  {description && <p class="repo-card-desc">{description}</p>}
  <footer class="repo-card-meta">
    <span class="repo-card-stat" title="Stars">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path fill="currentColor" d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"/>
      </svg>
      <span>{stargazers_count}</span>
    </span>
    <span class="repo-card-stat" title="Forks">
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <path fill="currentColor" d="M5 3.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm0 2.122a2.25 2.25 0 10-1.5 0v.878A2.25 2.25 0 005.75 8.5h1.5v2.128a2.25 2.25 0 101.5 0V8.5h1.5a2.25 2.25 0 002.25-2.25v-.878a2.25 2.25 0 10-1.5 0v.878a.75.75 0 01-.75.75h-4.5A.75.75 0 015 6.25v-.878zm3.75 7.378a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm3-8.75a.75.75 0 100-1.5.75.75 0 000 1.5z"/>
      </svg>
      <span>{forks_count}</span>
    </span>
  </footer>
</article>
