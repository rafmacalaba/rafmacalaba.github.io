---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";
import NowPullQuote from "../components/NowPullQuote.astro";
import SocialIcons from "../components/SocialIcons.astro";
import { siteConfig } from "../lib/site.ts";
import { fetchGitHubData } from "../lib/github.ts";
import { getRecentPosts, getFeaturedProjects, getNow } from "../lib/content.ts";

const data = await fetchGitHubData();
const { profile } = data;

const featured = (await getFeaturedProjects()).slice(0, 4);
const recentPosts = await getRecentPosts(3);
const now = await getNow();

const nowExcerpt = (() => {
  if (!now) return "";
  const lines = now.body
    .split("\n")
    .map((l) => l.trim())
    .filter((l) => l && !l.startsWith("#") && !l.startsWith("-"));
  return lines[0] ?? "";
})();

const contactLinks: { href: string; label: string }[] = [
  ...siteConfig.contactLinks,
];
if (profile.html_url && !contactLinks.some((c) => c.href === profile.html_url)) {
  contactLinks.push({ href: profile.html_url, label: "GitHub profile" });
}
---

<BaseLayout
  title={siteConfig.name}
  description={siteConfig.tagline}
>
  <section class="hero">
    <div>
      <p class="hero-kicker">{profile.location ?? "Available for collaboration"}</p>
      <h1 class="hero-name">{siteConfig.name}</h1>
      <p class="hero-tagline">{siteConfig.tagline}</p>
    </div>
    {profile.avatar_url && (
      <img
        class="hero-avatar"
        src={profile.avatar_url}
        alt={`${siteConfig.name} avatar`}
        width="96"
        height="96"
        loading="eager"
      />
    )}
    <SocialIcons />
  </section>

  {featured.length > 0 && (
    <section class="section">
      <header class="section-header">
        <h2 class="section-title">Highlights</h2>
        <a class="section-link" href="/work">All work &rarr;</a>
      </header>
      <div class="project-grid">
        {featured.map((p) => (
          <ProjectCard
            title={p.data.title}
            domain={p.data.domain}
            year={p.data.year}
            summary={p.data.summary}
            links={p.data.links}
            slug={p.slug}
          />
        ))}
      </div>
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="section">
      <header class="section-header">
        <h2 class="section-title">Recent writing</h2>
        <a class="section-link" href="/writing">All writing &rarr;</a>
      </header>
      <div class="post-list">
        {recentPosts.map((p) => (
          <PostCard
            title={p.data.title}
            description={p.data.description}
            pubDate={p.data.pubDate}
            href={`/blog/${p.slug}`}
          />
        ))}
      </div>
    </section>
  )}

  {now && <NowPullQuote excerpt={nowExcerpt} />}

  {contactLinks.length > 0 && (
    <section class="section">
      <h2 class="section-title">Contact</h2>
      <ul class="contact-list">
        {contactLinks.map((link) => (
          <li><a href={link.href} rel="noopener noreferrer">{link.label}</a></li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
