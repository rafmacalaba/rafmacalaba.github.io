---
import BaseLayout from "../layouts/BaseLayout.astro";
import RepoCard from "../components/RepoCard.astro";
import HighlightItem from "../components/HighlightItem.astro";
import { fetchGitHubData } from "../lib/github.ts";
import { getRecentHighlights } from "../lib/highlights.ts";

const data = await fetchGitHubData();
const { profile, pinnedRepos } = data;

const profileName = profile.name ?? profile.login;
const tagline = profile.company ?? "Researcher · Data Scientist";
const bio =
  profile.bio ?? "Building tools at the intersection of data, research, and policy.";
const recent = await getRecentHighlights(4);
const topRepos = pinnedRepos.slice(0, 6);

const contactLinks: { href: string; label: string }[] = [
  { href: profile.html_url, label: "GitHub" },
];
if (profile.blog) {
  contactLinks.push({ href: profile.blog, label: "Website" });
}
---

<BaseLayout
  title="Rafael Macalaba"
  description={`Personal portfolio of ${profileName} — ${tagline}.`}
>
  <section class="hero">
    <div>
      <h1 class="hero-name">{profileName}</h1>
      <p class="hero-tagline">{tagline}</p>
      {profile.location && <p class="hero-meta">{profile.location}</p>}
    </div>
    {profile.avatar_url && (
      <img
        class="hero-avatar"
        src={profile.avatar_url}
        alt={`${profileName} avatar`}
        width="96"
        height="96"
        loading="eager"
      />
    )}
  </section>

  <section class="section">
    <p class="bio">{bio}</p>
  </section>

  <section class="section">
    <header class="section-header">
      <h2 class="section-title">Recent highlights</h2>
      <a class="section-link" href="/highlights">All highlights &rarr;</a>
    </header>
    <div class="highlights-strip">
      {recent.map((h) => (
        <HighlightItem
          title={h.title}
          url={h.url}
          description={h.description}
          venue={h.venue}
          date={h.date}
        />
      ))}
    </div>
  </section>

  <section class="section">
    <header class="section-header">
      <h2 class="section-title">Pinned projects</h2>
      <a class="section-link" href="/projects">All projects &rarr;</a>
    </header>
    {topRepos.length > 0 ? (
      <div class="grid">
        {topRepos.map((r) => (
          <RepoCard
            name={r.name}
            description={r.description}
            html_url={r.html_url}
            language={r.language}
            stargazers_count={r.stargazers_count}
            forks_count={r.forks_count}
          />
        ))}
      </div>
    ) : (
      <p class="bio">No pinned projects yet.</p>
    )}
  </section>

  <section class="section">
    <h2 class="section-title">Contact</h2>
    <ul class="contact-list">
      {contactLinks.map((link) => (
        <li><a href={link.href} rel="noopener noreferrer">{link.label}</a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
