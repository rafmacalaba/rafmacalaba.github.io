---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";
import SocialIcons from "../components/SocialIcons.astro";
import { siteConfig } from "../lib/site.ts";
import { fetchGitHubData } from "../lib/github.ts";
import { getRecentPosts, getFeaturedProjects, getNow } from "../lib/content.ts";

const data = await fetchGitHubData();
const { profile } = data;
const featured = (await getFeaturedProjects()).slice(0, 3);
const recentPosts = await getRecentPosts(3);
const now = await getNow();

const nowExcerpt = (() => {
  if (!now) return "";
  const firstParagraph = now.body.split(/\n\s*\n/).map((p) => p.trim()).find(Boolean) ?? "";
  const sentences = firstParagraph.match(/[^.!?]+[.!?]+|[^.!?]+$/g) ?? [firstParagraph];
  return sentences.slice(0, 2).join(" ").trim();
})();

const emailLink = siteConfig.contactLinks.find((link) => link.label === "Email");
---

<BaseLayout title={siteConfig.name} description={siteConfig.tagline}>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-copy">
      <p class="home-kicker">Researcher and builder <span aria-hidden="true">/</span> World Bank</p>
      <h1 id="home-title">Rafael Macalaba</h1>
      <p class="hero-tagline">{siteConfig.tagline}</p>
      <p class="home-intro">
        I’m exploring small language models for low-resource settings, including on-device inference in the browser. Other threads include search and reranking systems, synthetic data, and practical AI evaluation.
      </p>
      <div class="home-actions">
        <a class="button button-primary" href="/work">Explore selected work</a>
        <a class="button button-secondary" href="/writing">Read recent writing</a>
      </div>
    </div>
    <aside class="home-portrait" aria-label="About Rafael">
      {profile.avatar_url && (
        <img
          class="hero-avatar"
          src={profile.avatar_url}
          alt={`${siteConfig.name}`}
          width="144"
          height="144"
          loading="eager"
        />
      )}
      <p class="portrait-place">{profile.location ?? "Washington, D.C."}</p>
      <p class="portrait-note">Applied AI<br />Research · Engineering · Open tools</p>
    </aside>
    <div class="home-social" aria-label="Find Rafael online">
      <SocialIcons />
    </div>
  </section>

  {featured.length > 0 && (
    <section class="home-section" aria-labelledby="selected-work-title">
      <header class="section-header">
        <div>
          <p class="section-kicker">From research to working tools</p>
          <h2 class="section-title" id="selected-work-title">Selected work</h2>
        </div>
        <a class="section-link" href="/work">All work <span aria-hidden="true">↗</span></a>
      </header>
      <div class="project-grid home-project-grid">
        {featured.map((project) => (
          <ProjectCard
            title={project.data.title}
            domain={project.data.domain}
            year={project.data.year}
            period={project.data.period}
            summary={project.data.summary}
            links={project.data.links}
            slug={project.slug}
          />
        ))}
      </div>
    </section>
  )}

  {recentPosts.length > 0 && (
    <section class="home-section" aria-labelledby="writing-title">
      <header class="section-header">
        <div>
          <p class="section-kicker">Ideas, methods, and field notes</p>
          <h2 class="section-title" id="writing-title">Recent writing</h2>
        </div>
        <a class="section-link" href="/writing">All writing <span aria-hidden="true">↗</span></a>
      </header>
      <div class="post-list home-post-list">
        {recentPosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            pubDate={post.data.pubDate}
            href={`/blog/${post.slug}`}
          />
        ))}
      </div>
    </section>
  )}

  {now && (
    <section class="home-now" aria-label="Current focus">
      <div>
        <p class="section-kicker">Current focus</p>
        <h2 class="home-now-title">What I’m working through now</h2>
        <p class="home-now-copy">{nowExcerpt}</p>
      </div>
      <a class="button button-secondary" href="/now">More on Now <span aria-hidden="true">↗</span></a>
    </section>
  )}

  <section class="home-contact" aria-labelledby="contact-title">
    <div>
      <p class="section-kicker">Continue the conversation</p>
      <h2 id="contact-title">Working on a data or AI problem?</h2>
      <p>Reach out about research, software, or collaboration.</p>
    </div>
    {emailLink && <a class="button button-primary" href={emailLink.href}>Email Rafael <span aria-hidden="true">↗</span></a>}
  </section>
</BaseLayout>
