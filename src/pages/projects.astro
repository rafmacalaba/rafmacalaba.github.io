---
import BaseLayout from "../layouts/BaseLayout.astro";
import RepoCard from "../components/RepoCard.astro";
import { fetchGitHubData } from "../lib/github.ts";

const data = await fetchGitHubData();
const { profile, pinnedRepos } = data;

// Cap at 30 per spec. pinnedRepos is already capped at 6 from the fetcher,
// so the grid renders pinned + nothing extra here (Phase 2 fetcher handles
// the per-language top-N expansion). We deduplicate by full_name.
const repos = pinnedRepos.slice(0, 30);

// Build unique language list for chips
const languageSet = new Set<string>();
for (const r of repos) {
  if (r.language) languageSet.add(r.language);
}
const languages = [...languageSet].sort((a, b) => a.localeCompare(b));
---

<BaseLayout
  title="Projects"
  description={`GitHub projects by ${profile.name ?? profile.login}.`}
>
  <header class="page-heading">
    <h1>Projects</h1>
    <p>Recent repositories from GitHub. Filter by language.</p>
  </header>

  {repos.length === 0 ? (
    <p class="bio">No projects to show yet.</p>
  ) : (
    <>
      <div class="lang-filter" role="group" aria-label="Filter projects by language">
        <button type="button" data-lang-filter="__all" aria-pressed="true">
          All
        </button>
        {languages.map((lang) => (
          <button type="button" data-lang-filter={lang} aria-pressed="false">
            {lang}
          </button>
        ))}
      </div>

      <div class="grid" data-repo-grid>
        {repos.map((r) => (
          <RepoCard
            name={r.name}
            description={r.description}
            html_url={r.html_url}
            language={r.language}
            stargazers_count={r.stargazers_count}
            forks_count={r.forks_count}
          />
        ))}
      </div>
    </>
  )}
</BaseLayout>

<script is:inline>
  (function () {
    var grid = document.querySelector("[data-repo-grid]");
    var filterBar = document.querySelector(".lang-filter");
    if (!grid || !filterBar) return;
    var buttons = filterBar.querySelectorAll("button[data-lang-filter]");

    function setActive(activeBtn) {
      for (var i = 0; i < buttons.length; i++) {
        buttons[i].setAttribute(
          "aria-pressed",
          buttons[i] === activeBtn ? "true" : "false"
        );
      }
    }

    function applyFilter(value) {
      var cards = grid.querySelectorAll(".repo-card");
      for (var i = 0; i < cards.length; i++) {
        var lang = cards[i].getAttribute("data-language") || "";
        var match = value === "__all" || lang === value;
        cards[i].setAttribute("data-hidden", match ? "false" : "true");
      }
    }

    filterBar.addEventListener("click", function (e) {
      var target = e.target;
      if (!(target instanceof HTMLElement)) return;
      var btn = target.closest("button[data-lang-filter]");
      if (!(btn instanceof HTMLButtonElement)) return;
      var value = btn.getAttribute("data-lang-filter") || "__all";
      setActive(btn);
      applyFilter(value);
    });
  })();
</script>
