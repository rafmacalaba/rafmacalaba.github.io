---
import BaseLayout from "../layouts/BaseLayout.astro";
import { socialIcon } from "../lib/social-icons.ts";

const externalLinks = [
  { label: "World Bank Blogs", href: "https://blogs.worldbank.org/en/team/r/rafael-sevilla-macalaba", icon: "worldbank" },
  { label: "GitHub", href: "https://github.com/rafmacalaba", icon: "github" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/rafaelmacalaba/", icon: "linkedin" },
  { label: "npm", href: "https://www.npmjs.com/~rafamacalaba", icon: "npm" },
  { label: "HuggingFace", href: "https://huggingface.co/rafmacalaba", icon: "huggingface" },
  { label: "Kaggle (Competitions Expert)", href: "https://www.kaggle.com/leafar", icon: "kaggle" },
  { label: "Email", href: "mailto:rafael.macalaba@yahoo.com", icon: "email" },
];

const focusAreas = [
  { label: "Small language models", text: "Exploring low-resource use cases and on-device inference in the browser." },
  { label: "Search and retrieval", text: "Embeddings, reranking, and systems that surface relevant evidence." },
  { label: "Synthetic data and evaluation", text: "Methods for testing AI systems and understanding their behavior." },
  { label: "Open systems", text: "Building tools with observable, reusable workflows." },
];
---

<BaseLayout title="About" description="Research, engineering, and applied AI.">
  <header class="page-intro about-intro">
    <p class="section-kicker">About Rafael</p>
    <h1>Research questions.<br />Working systems.</h1>
    <p>I work at the World Bank on applied AI. My work connects research on how evidence is used with tools that make complex workflows easier to inspect and scale.</p>
  </header>

  <div class="about-layout">
    <section class="about-story" aria-labelledby="about-story-title">
      <h2 id="about-story-title">A little more context</h2>
      <p>My research focuses on monitoring how sources are cited and used in published work. I’m interested in how language models and synthetic data can make that analysis more systematic while keeping the evidence behind each result visible.</p>
      <p>I also build open-source software—from information retrieval to systems for coordinating AI agents. Across both, I care about making complex work observable: what information went in, what a system concluded, and why.</p>
      <a class="text-link" href="/work">Explore selected work <span aria-hidden="true">↗</span></a>
    </section>

    <aside class="about-focus" aria-labelledby="focus-title">
      <p class="section-kicker">Current threads</p>
      <h2 id="focus-title">What I work on</h2>
      <ol>
        {focusAreas.map((area, index) => (
          <li><span class="focus-number">0{index + 1}</span><div><h3>{area.label}</h3><p>{area.text}</p></div></li>
        ))}
      </ol>
    </aside>
  </div>

  <section class="experience-section" aria-labelledby="experience-title">
    <header class="section-header">
      <div><p class="section-kicker">Earlier experience</p><h2 class="section-title" id="experience-title">Work history</h2></div>
    </header>
    <article class="experience-entry">
      <p class="experience-period"><time datetime="2019-03">Mar 2019</time>–<time datetime="2020-04">Apr 2020</time></p>
      <div class="experience-copy">
        <p class="experience-role">Data Scientist <span aria-hidden="true">·</span> Kalibrr</p>
        <p class="experience-context">Y Combinator-backed startup in Southeast Asia</p>
        <p>Worked on data processing and visualizations for Kalibrr’s job-matching platform, and developed statistical and machine-learning models to analyze job-seeker behavior and support predictive analytics.</p>
        <ul class="experience-links" aria-label="Kalibrr company information">
          <li><a href="https://www.ycombinator.com/companies/kalibrr" target="_blank" rel="noopener noreferrer">Y Combinator profile</a></li>
          <li><a href="https://www.ycdb.co/company/kalibrr" target="_blank" rel="noopener noreferrer">YCDB profile</a></li>
        </ul>
      </div>
    </article>
  </section>

  <section class="about-links" aria-labelledby="elsewhere-title">
    <header class="section-header">
      <div><p class="section-kicker">More of my work</p><h2 class="section-title" id="elsewhere-title">Elsewhere</h2></div>
    </header>
    <div class="external-links-row">
      {externalLinks.map((link) => {
        const isMailto = link.icon === "email";
        return (
          <a href={link.href} class="icon-link" {...(!isMailto ? { rel: "noopener noreferrer", target: "_blank" } : {})}>
            <span aria-hidden="true" set:html={socialIcon(link.icon)} />{link.label}
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
