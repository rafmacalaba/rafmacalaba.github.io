---
import BaseLayout from "../layouts/BaseLayout.astro";

const externalLinks = [
  { label: "World Bank Blogs", href: "https://blogs.worldbank.org/en/team/r/rafael-sevilla-macalaba", icon: "worldbank" },
  { label: "GitHub", href: "https://github.com/rafmacalaba", icon: "github" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/rafaelmacalaba/", icon: "linkedin" },
  { label: "npm", href: "https://www.npmjs.com/~rafamacalaba", icon: "npm" },
  { label: "Email", href: "mailto:rafael.macalaba@yahoo.com", icon: "email" },
];

const papers = [
  { title: "Large Language Models and Synthetic Data for Monitoring Dataset Mentions in Research Papers", venue: "ICLR 2025 Workshop", href: "https://arxiv.org/abs/2502.10263", paperHref: "", coauthored: false },
  { title: "AI for Monitoring and Classifying Data Used in Research Literature", venue: "Preprint", href: "https://arxiv.org/abs/2605.30582", paperHref: "", coauthored: false },
  { title: "Field Order Should Not Matter: Permutation-Invariant Embedding Model Fine-Tuning for Structured Metadata Retrieval", venue: "Preprint", href: "https://arxiv.org/abs/2606.30473", paperHref: "", coauthored: false },
  { title: "Climate Change AI track paper", venue: "ICLR 2025 / Climate Change AI", href: "https://www.climatechange.ai/papers/iclr2025/63", paperHref: "https://ccai-papers.s3.us-east-1.amazonaws.com/iclr2025/63/paper.pdf", coauthored: false },
];

const repos = [
  { label: "ai4data", href: "https://github.com/worldbank/ai4data" },
  { label: "data360-mcp", href: "https://github.com/worldbank/data360-mcp" },
  { label: "data360-chatbot", href: "https://github.com/worldbank/data-ai-chatbot" },
  { label: "proof-carrying-numbers (pcn)", href: "https://github.com/worldbank/pcn" },
];

const blogs = [
  { label: "Tracking Dataset Use at Scale with AI: How Synthetic Data Helps", href: "https://blogs.worldbank.org/en/opendata/tracking-dataset-use-at-scale-with-ai--how-synthetic-data-helps-" },
];

function iconFor(name: string): string {
  switch (name) {
    case "github":
      return `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>`;
    case "linkedin":
      return `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>`;
    case "npm":
      return `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8h20v8H2z"/><path d="M6 8v8h4V8m4 0v8h4V8"/></svg>`;
    case "email":
      return `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>`;
    case "worldbank":
      return `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`;
    case "link-external":
      return `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" x2="21" y1="14" y2="3"/></svg>`;
    default:
      return "";
  }
}
---

<BaseLayout
  title="About"
  description="Background, publications, and contact information."
>
  <header class="page-heading">
    <h1>About</h1>
  </header>

  <section class="section">
    <p class="bio">
      Rafael Sevilla Macalaba works at the World Bank on AI for development data.
      His research focuses on monitoring how datasets are used in published research,
      with a current emphasis on synthetic data and large language models for
      scalable evaluation.
    </p>
  </section>

  <section class="section">
    <h2 class="section-title">External Links</h2>
    <div class="external-links-row">
      {externalLinks.map((link) => {
        const isMailto = link.icon === "email";
        return (
          <a
            href={link.href}
            class="icon-link"
            {...(!isMailto ? { rel: "noopener noreferrer", target: "_blank" } : {})}
          >
            <span aria-hidden="true" set:html={iconFor(link.icon)} />
            {link.label}
          </a>
        );
      })}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">Papers</h2>
    <ol class="papers-list">
      {papers.map((paper) => (
        <li>
          <a
            href={paper.href}
            rel="noopener noreferrer"
            target="_blank"
            class="paper-title"
          >
            {paper.title}
          </a>
          <span class="paper-venue"> &mdash; {paper.venue}</span>
          {paper.paperHref && (
            <span class="paper-secondary">
              {" "}
              <a
                href={paper.paperHref}
                rel="noopener noreferrer"
                target="_blank"
              >
                [paper.pdf]
              </a>
            </span>
          )}
        </li>
      ))}
    </ol>
  </section>

  <section class="section">
    <h2 class="section-title">Repos</h2>
    <ul class="repos-list">
      {repos.map((repo) => (
        <li>
          <a
            href={repo.href}
            class="icon-link"
            rel="noopener noreferrer"
            target="_blank"
          >
            <span aria-hidden="true" set:html={iconFor("github")} />
            {repo.label}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2 class="section-title">Blogs</h2>
    <ul class="blogs-list">
      {blogs.map((blog) => (
        <li>
          <a
            href={blog.href}
            class="icon-link"
            rel="noopener noreferrer"
            target="_blank"
          >
            <span aria-hidden="true" set:html={iconFor("link-external")} />
            {blog.label}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
