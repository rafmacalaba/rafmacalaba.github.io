---
import BaseLayout from "../layouts/BaseLayout.astro";
import { socialIcon } from "../lib/social-icons.ts";

const externalLinks = [
  { label: "World Bank Blogs", href: "https://blogs.worldbank.org/en/team/r/rafael-sevilla-macalaba", icon: "worldbank" },
  { label: "GitHub", href: "https://github.com/rafmacalaba", icon: "github" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/rafaelmacalaba/", icon: "linkedin" },
  { label: "npm", href: "https://www.npmjs.com/~rafamacalaba", icon: "npm" },
  { label: "HuggingFace", href: "https://huggingface.co/rafmacalaba", icon: "huggingface" },
  { label: "Kaggle (Competitions Expert)", href: "https://www.kaggle.com/leafar", icon: "kaggle" },
  { label: "Email", href: "mailto:rafael.macalaba@yahoo.com", icon: "email" },
];
---

<BaseLayout
  title="About"
  description="Background, publications, and contact information."
>
  <header class="page-heading">
    <h1>About</h1>
  </header>

  <section class="section">
    <p class="bio">
      Rafael Sevilla Macalaba works at the World Bank on AI for development data.
      His research focuses on monitoring how datasets are used in published research,
      with a current emphasis on synthetic data and large language models for
      scalable evaluation.
    </p>
  </section>

  <section class="section">
    <h2 class="section-title">External Links</h2>
    <div class="external-links-row">
      {externalLinks.map((link) => {
        const isMailto = link.icon === "email";
        return (
          <a
            href={link.href}
            class="icon-link"
            {...(!isMailto ? { rel: "noopener noreferrer", target: "_blank" } : {})}
          >
            <span aria-hidden="true" set:html={socialIcon(link.icon)} />
            {link.label}
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
