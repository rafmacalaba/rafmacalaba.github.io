---
import BaseLayout from "../layouts/BaseLayout.astro";
import { socialIcon } from "../lib/social-icons.ts";

const externalLinks = [
  { label: "World Bank Blogs", href: "https://blogs.worldbank.org/en/team/r/rafael-sevilla-macalaba", icon: "worldbank" },
  { label: "GitHub", href: "https://github.com/rafmacalaba", icon: "github" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/rafaelmacalaba/", icon: "linkedin" },
  { label: "npm", href: "https://www.npmjs.com/~rafamacalaba", icon: "npm" },
  { label: "HuggingFace", href: "https://huggingface.co/rafmacalaba", icon: "huggingface" },
  { label: "Kaggle (Competitions Expert)", href: "https://www.kaggle.com/leafar", icon: "kaggle" },
  { label: "Email", href: "mailto:rafael.macalaba@yahoo.com", icon: "email" },
];

const focusAreas = [
  { label: "Dataset use", text: "Finding and describing how datasets appear in published research." },
  { label: "AI for evaluation", text: "Using language models and synthetic data to make research monitoring more scalable." },
  { label: "Open tools", text: "Building practical systems for development data, retrieval, and evidence-led workflows." },
];
---

<BaseLayout title="About" description="Research, engineering, and AI for development data.">
  <header class="page-intro about-intro">
    <p class="section-kicker">About Rafael</p>
    <h1>Research questions.<br />Working systems.</h1>
    <p>I work at the World Bank on AI for development data, between research on how datasets are used and tools that make data workflows easier to inspect and scale.</p>
  </header>

  <div class="about-layout">
    <section class="about-story" aria-labelledby="about-story-title">
      <h2 id="about-story-title">A little more context</h2>
      <p>My research focuses on monitoring how datasets appear and are used in published research. I’m interested in how AI, language models, and synthetic data can help make that work more systematic without losing sight of the evidence behind a result.</p>
      <p>I also build open-source software—from data analysis and retrieval tools to systems for coordinating AI agents. The common thread is making complex work more observable: what information went in, what a system concluded, and why.</p>
      <a class="text-link" href="/work">Explore selected work <span aria-hidden="true">↗</span></a>
    </section>

    <aside class="about-focus" aria-labelledby="focus-title">
      <p class="section-kicker">Current threads</p>
      <h2 id="focus-title">What I work on</h2>
      <ol>
        {focusAreas.map((area, index) => (
          <li><span class="focus-number">0{index + 1}</span><div><h3>{area.label}</h3><p>{area.text}</p></div></li>
        ))}
      </ol>
    </aside>
  </div>

  <section class="about-links" aria-labelledby="elsewhere-title">
    <header class="section-header">
      <div><p class="section-kicker">More of my work</p><h2 class="section-title" id="elsewhere-title">Elsewhere</h2></div>
    </header>
    <div class="external-links-row">
      {externalLinks.map((link) => {
        const isMailto = link.icon === "email";
        return (
          <a href={link.href} class="icon-link" {...(!isMailto ? { rel: "noopener noreferrer", target: "_blank" } : {})}>
            <span aria-hidden="true" set:html={socialIcon(link.icon)} />{link.label}
          </a>
        );
      })}
    </div>
  </section>
</BaseLayout>
