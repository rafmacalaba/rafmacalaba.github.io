---
import BaseLayout from "../layouts/BaseLayout.astro";

const bio = `I work at the intersection of data, research, and applied systems. Most of my days split between writing code that other researchers use, reading the literature on how to evaluate that code fairly, and advising institutions on what is actually publishable versus what is merely possible.

My background is mixed: a graduate degree in a quantitative field, several years inside multilateral organizations, and a long stretch of writing open-source tooling on the side. The through-line is an allergy to claims that are not earned by the methodology behind them. I would rather build a smaller thing that holds up than a larger thing that doesn't.

I write here when I have something that has cleared internal review — usually a recalibration, a definition, or a workflow that other practitioners might find useful.`;

const timeline = [
  { years: "2022 — present", role: "Independent researcher and engineer", org: "Self-directed; advisory for multilateral organizations" },
  { years: "2019 — 2022", role: "Data scientist", org: "Multilateral organization, development data" },
  { years: "2016 — 2019", role: "Research assistant", org: "Graduate research group" },
  { years: "2014 — 2016", role: "Software engineer", org: "Industry, data infrastructure" },
];

const skills: { group: string; items: string[] }[] = [
  { group: "research", items: ["study design", "evaluation methodology", "literature review", "causal inference"] },
  { group: "engineering", items: ["Python", "TypeScript", "Astro", "data pipelines", "open-source maintenance"] },
  { group: "policy", items: ["open data standards", "publication ethics", "institutional review"] },
];
---

<BaseLayout
  title="About"
  description="Background, career timeline, and tools."
>
  <header class="page-heading">
    <h1>About</h1>
  </header>

  <section class="prose">
    {bio.split("\n\n").map((para) => <p>{para}</p>)}
  </section>

  <section class="section">
    <h2 class="section-title">Career</h2>
    <ul class="timeline">
      {timeline.map((t) => (
        <li>
          <span class="timeline-year">{t.years}</span>
          <p class="timeline-body">
            <strong>{t.role}</strong> &middot; {t.org}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="section">
    <h2 class="section-title">Skills and tools</h2>
    {skills.map((s) => (
      <div class="skills-group">
        <h3>{s.group}</h3>
        <ul class="skills-list">
          {s.items.map((i) => <li>{i}</li>)}
        </ul>
      </div>
    ))}
  </section>
</BaseLayout>
