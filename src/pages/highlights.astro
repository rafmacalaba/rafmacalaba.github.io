---
import BaseLayout from "../layouts/BaseLayout.astro";
import HighlightItem from "../components/HighlightItem.astro";
import { getHighlightsByType } from "../lib/highlights.ts";

const groups = await getHighlightsByType();

// Render order
const ORDER = ["paper", "blog", "talk", "repo", "other"];
const sortedTypes = [...groups.keys()].sort(
  (a, b) => ORDER.indexOf(a) - ORDER.indexOf(b)
);
---

<BaseLayout
  title="Highlights"
  description="Papers, blogs, talks, and other highlights from Rafael Macalaba."
>
  <header class="page-heading">
    <h1>Highlights</h1>
    <p>Papers, blogs, talks, and other work, grouped by type.</p>
  </header>

  {sortedTypes.length === 0 ? (
    <p class="bio">No highlights yet.</p>
  ) : (
    sortedTypes.map((type) => {
      const entries = groups.get(type) ?? [];
      return (
        <section class="highlight-group">
          <h2 class="highlight-group-title">{type}s</h2>
          <div class="highlight-list">
            {entries.map((h) => (
              <HighlightItem
                title={h.title}
                url={h.url}
                description={h.description}
                venue={h.venue}
                date={h.date}
              />
            ))}
          </div>
        </section>
      );
    })
  )}
</BaseLayout>
