---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getProjects } from "../lib/content.ts";

const projects = await getProjects();
const selected = projects.filter((project) => project.data.featured === true);
const other = projects.filter((project) => project.data.featured !== true);
---

<BaseLayout title="Work" description="Selected research and software projects.">
  <header class="page-intro">
    <p class="section-kicker">Research · Engineering · Open source</p>
    <h1>Work</h1>
    <p>Selected research and software, from information retrieval and evaluation to open-source systems.</p>
  </header>

  {projects.length === 0 ? (
    <div class="empty-state"><p>Work is being gathered here.</p></div>
  ) : (
    <>
      {selected.length > 0 && (
        <section class="work-section" aria-labelledby="selected-projects-title">
          <header class="section-header">
            <div><p class="section-kicker">A few starting points</p><h2 class="section-title" id="selected-projects-title">Selected projects</h2></div>
            <span class="section-count">{selected.length} projects</span>
          </header>
          <div class="project-grid work-featured-grid">
            {selected.map((project) => (
              <ProjectCard title={project.data.title} domain={project.data.domain} year={project.data.year}
                summary={project.data.summary} links={project.data.links} slug={project.slug} />
            ))}
          </div>
        </section>
      )}

      {other.length > 0 && (
        <section class="work-section" aria-labelledby="other-projects-title">
          <header class="section-header">
            <div><p class="section-kicker">Additional work and earlier contributions</p><h2 class="section-title" id="other-projects-title">More work</h2></div>
            <span class="section-count">{other.length} projects</span>
          </header>
          <div class="project-grid">
            {other.map((project) => (
              <ProjectCard title={project.data.title} domain={project.data.domain} year={project.data.year}
                summary={project.data.summary} links={project.data.links} slug={project.slug} />
            ))}
          </div>
        </section>
      )}
    </>
  )}
</BaseLayout>
