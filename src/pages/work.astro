---
import BaseLayout from "../layouts/BaseLayout.astro";
import Chip from "../components/Chip.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getProjects } from "../lib/content.ts";

const projects = await getProjects();

const chips: { label: string; value: string }[] = [
  { label: "All", value: "all" },
  { label: "Research", value: "research" },
  { label: "Engineering", value: "engineering" },
  { label: "Policy", value: "policy" },
];
---

<BaseLayout
  title="Work"
  description="Selected projects across research, engineering, and policy."
>
  <header class="page-heading">
    <h1>Work</h1>
    <p>
      Curated projects. Filter by domain. Each card links to artifacts
      (papers, repositories, talks).
    </p>
  </header>

  <div class="chip-row" role="group" aria-label="Filter projects by domain">
    {chips.map((c, i) => (
      <Chip
        label={c.label}
        value={c.value}
        group="domain"
        pressed={i === 0}
      />
    ))}
  </div>

  <div class="project-grid">
    {projects.map((p) => (
      <ProjectCard
        title={p.data.title}
        domain={p.data.domain}
        year={p.data.year}
        summary={p.data.summary}
        links={p.data.links}
        slug={p.slug}
      />
    ))}
  </div>

  <script>
    import "../scripts/filter.ts";
  </script>
</BaseLayout>
