---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

const entries = await getCollection("now");
const now = entries[0];
const Content = now ? (await render(now)).Content : null;
const updatedLabel = now
  ? now.data.updated.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
      timeZone: "UTC",
    })
  : "";
---

<BaseLayout title="Now" description="Current questions and projects in progress.">
  <article class="now-page">
    <header class="now-header">
      <p class="section-kicker">Current focus</p>
      <h1>Now</h1>
      <p class="now-dek">A working note on the questions and systems occupying my time.</p>
      {now && <p class="now-updated">Updated <time datetime={now.data.updated.toISOString()}>{updatedLabel}</time></p>}
    </header>
    {Content ? <div class="now-content"><Content /></div> : <p>No updates yet.</p>}
  </article>
</BaseLayout>
