---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { getPublishedPosts } from "../lib/content.ts";

const posts = await getPublishedPosts();
---

<BaseLayout title="Writing" description="Papers and field notes on AI, research methods, retrieval, and engineering.">
  <header class="page-intro writing-intro">
    <div>
      <p class="section-kicker">Ideas in public</p>
      <h1>Writing</h1>
      <p>Papers, methods, and field notes on AI, research, and building useful systems.</p>
    </div>
    <a class="button button-secondary" href="/rss.xml">RSS feed <span aria-hidden="true">↗</span></a>
  </header>

  {posts.length === 0 ? (
    <div class="empty-state"><p>Writing will appear here as it is published.</p></div>
  ) : (
    <section class="writing-index" aria-label="Published writing, newest first">
      <p class="index-note">{posts.length} pieces <span aria-hidden="true">·</span> Newest first</p>
      <div class="post-list">
        {posts.map((post) => (
          <PostCard title={post.data.title} description={post.data.description} pubDate={post.data.pubDate} href={`/blog/${post.slug}`} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
