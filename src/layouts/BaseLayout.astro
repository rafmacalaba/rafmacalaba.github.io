---
import { existsSync, readFileSync } from "node:fs";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
import { siteConfig } from "../lib/site.ts";

interface Props {
  title?: string;
  description?: string;
  chrome?: boolean;
  prose?: boolean;
}

const {
  title = siteConfig.name,
  description = `${siteConfig.tagline} — ${siteConfig.name}.`,
  chrome = true,
  prose = false,
} = Astro.props;

const fullTitle = title === siteConfig.name ? title : `${title} — ${siteConfig.name}`;

// The bundle ships no Cache-Control and GitHub Pages answers with max-age=600, so without a version query
// a deploy can serve the previous embed.js for ten minutes — long enough that a fixed bug stays visible.
// The pack writes version.json before this build runs; the query changes whenever the SDK revision does.
// The chunks embed.js imports are already named by hash, so the entry point is the only file to bust.
const slmVersionFile = "public/portable-slm/version.json";
const slmBundleQuery = existsSync(slmVersionFile)
  ? `?v=${JSON.parse(readFileSync(slmVersionFile, "utf8")).gitSha ?? "dev"}`
  : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme") || "light";
          document.documentElement.setAttribute("data-theme", stored);
          document.documentElement.setAttribute("data-theme-pref", stored);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    {chrome && <SiteNav />}
    <main
      id="main-content"
      class:list={["site-main", prose && "site-main--prose"]}
    >
      <slot />
    </main>
    {chrome && <SiteFooter />}
    {
      /* On-device assistant (Portable SLM). Read-only and opt-in: the panel stays closed behind the
         launcher until a visitor opens it, and the model is downloaded only if they install it.
         The bundle is assembled into public/portable-slm at build time by scripts/pack-slm.mjs. */
      chrome && (
        <>
          <div id="pslm-panel" class="pslm" data-pslm data-launcher="Ask this site" data-resize />
          <p data-pslm-note role="status" hidden />
          <script is:inline type="module" src={`/portable-slm/embed.js${slmBundleQuery}`} />
        </>
      )
    }
    <script is:inline src="/scripts/theme.js"></script>
  </body>
</html>
